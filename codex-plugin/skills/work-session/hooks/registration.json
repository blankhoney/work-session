{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__WORK_SESSION_ROOT__/hooks/work-session-bootstrap.cjs\" hook --host codex",
            "timeout": 35,
            "statusMessage": "Checking Work Session dependencies..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Shell|shell_command|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__WORK_SESSION_ROOT__/hooks/work-session-bootstrap.cjs\" hook --host codex",
            "timeout": 5,
            "statusMessage": "Confirming Work Session dependency changes..."
          }
        ]
      }
    ]
  }
}
